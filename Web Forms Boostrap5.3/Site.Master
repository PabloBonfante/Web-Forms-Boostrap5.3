<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Web_Forms_Boostrap5._3.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Mi aplicación ASP.NET</title>

    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/Content/Images/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>
<body>
    <form runat="server" class="d-flex flex-column">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Path="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <asp:ScriptReference Path="~/lib/bootstrap/dist/js/theme.min.js" />
                <asp:ScriptReference Path="~/Scripts/Site.js" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <header>
            <nav class="navbar navbar-expand-md navbar-dark fixed-top bg-dark">
                <div class="container-fluid">
                    <a runat="server" class="navbar-brand" href="~/" title="Ir al inicio">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 118 94" role="img" class="d-block my-1" height="32" width="40"><title>Bootstrap</title>
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M24.509 0c-6.733 0-11.715 5.893-11.492 12.284.214 6.14-.064 14.092-2.066 20.577C8.943 39.365 5.547 43.485 0 44.014v5.972c5.547.529 8.943 4.649 10.951 11.153 2.002 6.485 2.28 14.437 2.066 20.577C12.794 88.106 17.776 94 24.51 94H93.5c6.733 0 11.714-5.893 11.491-12.284-.214-6.14.064-14.092 2.066-20.577 2.009-6.504 5.396-10.624 10.943-11.153v-5.972c-5.547-.529-8.934-4.649-10.943-11.153-2.002-6.484-2.28-14.437-2.066-20.577C105.214 5.894 100.233 0 93.5 0H24.508zM80 57.863C80 66.663 73.436 72 62.543 72H44a2 2 0 01-2-2V24a2 2 0 012-2h18.437c9.083 0 15.044 4.92 15.044 12.474 0 5.302-4.01 10.049-9.119 10.88v.277C75.317 46.394 80 51.21 80 57.863zM60.521 28.34H49.948v14.934h8.905c6.884 0 10.68-2.772 10.68-7.727 0-4.643-3.264-7.207-9.012-7.207zM49.948 49.2v16.458H60.91c7.167 0 10.964-2.876 10.964-8.281 0-5.406-3.903-8.178-11.425-8.178H49.948z" fill="currentColor"></path>
                        </svg>
                    </a>
                    <button class="navbar-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                    <div class="navbar-collapse collapse" id="navbarCollapse">
                        <ul class="navbar-nav me-auto mb-2 mb-md-0">
                            <li class="nav-item">
                                <a runat="server" class="nav-link" href="~/Pages/FormCheck.aspx">Form Check</a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" class="nav-link" href="~/Pages/Validation.aspx">Validation</a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" class="nav-link" href="~/Pages/Icons.aspx">Icons</a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" class="nav-link" href="~/Pages/Menu.aspx">Menu</a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" class="nav-link" href="~/Pages/Tree.aspx">Tree</a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" class="nav-link" href="~/Pages/ListGroup.aspx">List Group</a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" class="nav-link" href="~/Pages/CalendarExample.aspx">CalendarExample</a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" class="nav-link" href="~/Pages/Cantidad.aspx">Cantidad</a>
                            </li>
                            <li class="nav-item">
                                <a runat="server" class="nav-link" href="~/Pages/Idempotence.aspx">Idempotence</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">GridView
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a runat="server" class="dropdown-item" href="~/Pages/Pagination.aspx">Pagination</a>
                                    </li>
                                    <li>
                                        <a runat="server" class="dropdown-item" href="~/Pages/SelectedTable.aspx">Selected GridView</a>
                                    </li>
                                    <li>
                                        <a runat="server" class="dropdown-item" href="~/Pages/Crud.aspx">Crud</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">JS Helpers
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a runat="server" class="dropdown-item" href="~/Pages/Modals.aspx">Modals</a>
                                    </li>
                                    <li>
                                        <a runat="server" class="dropdown-item" href="~/Pages/ConfirmModal.aspx">Confirm Modal</a>
                                    </li>
                                    <li>
                                        <a runat="server" class="dropdown-item" href="~/Pages/Toasts.aspx">Toasts</a>
                                    </li>
                                    <li>
                                         <a runat="server" class="dropdown-item" href="~/Pages/Patron.aspx">Patron de bloqueo</a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                        <div class="d-flex" role="search">
                            <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
                            <button class="btn btn-outline-success" type="button">Search</button>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <main class="flex-shrink-0">
            <div class="container">
                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            </div>
        </main>

        <footer class="footer mt-auto py-3 bg-body-tertiary">
            <div class="container">
                <span class="text-body-secondary">Place sticky footer content here.</span>
            </div>
        </footer>

        <div class="dropdown position-fixed bottom-0 end-0 mb-2 me-2">
            <button class="btn btn-primary py-2 dropdown-toggle d-flex align-items-center bi bi-moon-stars"
                id="bd-theme"
                type="button"
                aria-expanded="false"
                data-bs-toggle="dropdown"
                aria-label="Toggle theme (auto)">
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="bd-theme-text">
                <li>
                    <button type="button" class="dropdown-item bi bi-brightness-high" data-bs-theme-value="light" aria-pressed="false">
                        Claro
                    </button>
                </li>
                <li>
                    <button type="button" class="dropdown-item bi bi-moon" data-bs-theme-value="dark" aria-pressed="false">
                        Oscuro
                    </button>
                </li>
                <li>
                    <button type="button" class="dropdown-item bi bi-highlights" data-bs-theme-value="auto" aria-pressed="true">
                        Automatico
                    </button>
                </li>
            </ul>
        </div>
    </form>
</body>
</html>
